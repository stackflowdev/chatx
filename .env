# ChatX Application Configuration
# Environment variable'lar CHATX_ prefix bilan boshlanadi
# Bu boshqa loyihalar bilan conflict qilmaslik uchun

# HTTP server port - server qaysi port'da tinglashi
CHATX_PORT=:8080

# In-memory store'da saqlanadigan maksimal xabarlar soni (har bir room uchun)
CHATX_STORE_MAX=100

# Yangi user ulanganda yuboriladigan tarix xabarlari soni
CHATX_HISTORY_COUNT=50

# WebSocket orqali qabul qilinadigan maksimal xabar hajmi (bayt)
CHATX_MAX_MESSAGE_SIZE=512

# WebSocket write timeout - browser'ga yozish uchun maksimal vaqt
CHATX_WRITE_WAIT=10s

# WebSocket pong timeout - browser'dan pong javobini kutish vaqti
CHATX_PONG_WAIT=60s

# Ping yuborish oralig'i - connection alive tutish uchun
CHATX_PING_PERIOD=54s

# Log darajasi - info, debug, error
CHATX_LOG_LEVEL=info