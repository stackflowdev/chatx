PORT=:8080
STORE_MAX=100
HISTORY_COUNT=50
# WebSocket orqali qabul qilinadigan maksimal xabar hajmi (bayt)
MAX_MESSAGE_SIZE=512
# WebSocket write timeout - browser'ga yozish uchun maksimal vaqt
WRITE_WAIT=10s
# WebSocket pong timeout - browser'dan pong javobini kutish vaqti
PONG_WAIT=60s
# Ping yuborish oralig'i - connection alive tutish uchun
PING_PERIOD=54s
LOG_LEVEL=info

# ========================================
# Database Configuration (PostgreSQL)
# ========================================

# Database host - localhost (development) yoki container name (production)
# docker-compose ishlatganda "db" (service name)
# Go dasturni bevosita ishlatganda "localhost"
DB_HOST=localhost

# PostgreSQL default port
DB_PORT=5432

# Database username - docker-compose.yml dagi POSTGRES_USER bilan bir xil bo'lishi kerak
DB_USER=chatuser

# Database password - MUHIM: production'da strong password ishlating!
DB_PASSWORD=chatpass

# Database nomi - alohida database ChatX uchun
DB_NAME=chatx

# SSL mode - development'da disable, production'da require
# Qiymatlar: disable, require, verify-ca, verify-full
DB_SSLMODE=disable
# Connection pool settings (optional - keyinchalik qo'shamiz)
# Maksimal open connection'lar soni
DB_MAX_OPEN_CONNS=25

# Maksimal idle (foydalanilmayotgan) connection'lar
DB_MAX_IDLE_CONNS=5

# Connection maksimal lifetime (minutlarda)
DB_CONN_MAX_LIFETIME=5m